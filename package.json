{
  "name": "bloom-l-ai-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm --filter dashboard build",
    "start": "pnpm --filter dashboard start",
    "company": "tsx scripts/company.ts",
    "sync-agents": "tsx scripts/sync-agents.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter dashboard typecheck",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check:secrets": "node --import tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
