# Bloom-L AI Company — 環境変数の雛形(実値はコミットしない)
# MVPでは全て任意。未設定でも動作する。

# AI実行モード: claude_code(既定・費用0円) | api(将来・Q2の代表者承認後のみ)
AI_MODE=claude_code

# Anthropic APIキー(API有効化時のみ。docs/DECISIONS.md Q2の承認手順を経ること)
ANTHROPIC_API_KEY=

TZ=Asia/Tokyo

# V5 Instagram公式API。既定は完全無効。秘密値はUI/DBへ保存しない。
# disabled | dry_run | live（liveは代表者が接続テスト後に明示変更）
META_PUBLISH_MODE=disabled
# Meta公式ドキュメントで現在利用する版を確認して明示更新する
META_GRAPH_API_VERSION=v23.0
# Instagram Loginで取得したプロアカウントIDとアクセストークン
META_IG_USER_ID=
META_ACCESS_TOKEN=
# Vercel Blobを使わず、独自の静的ホスティングを使う場合だけ設定する代替URL基点。
# BLOB_READ_WRITE_TOKENで公開画像を準備する運用では空欄のままでよい。
META_MEDIA_BASE_URL=

# V5.2 公開画像ストレージ(Vercel Blob)。export bundleの確定画像をMetaが取得できる
# 公開HTTPS URLへ配置するために使う。トークンは絶対にコミットしない。
# 取得方法: Vercelダッシュボード → Storage → Blob → Read/Writeトークンを発行
BLOB_READ_WRITE_TOKEN=

# ---- V5.4 クラウド対応基盤(詳細: docs/26-v54-vercel-cloud-readiness.md) ----

# DBプロバイダー。既定はsqlite(ローカル運用の正)。postgresはVercel移行後に使う予約値で、
# V5.4時点では接続未実装のため指定するとfail closedで停止する。
DATABASE_PROVIDER=sqlite
# PostgreSQL接続文字列(postgres指定時のみ必須)。値はログ・UI・監査ログへ出力しない。実値をコミットしない。
DATABASE_URL=

# 実行モード。既定はlocal(代表者のMac)。Vercel上ではVERCEL_ENVから自動的にcloud扱いになる。
APP_RUNTIME_MODE=local
# クラウド公開時のowner認証方式(未確定)。未設定・未実装のcloud実行では変更系APIが全て拒否される(fail closed)。
OWNER_AUTH_PROVIDER=

# Vercel本番でのInstagram実投稿の二重条件。META_PUBLISH_MODE=liveに加えてtrueが必要。
# Preview環境ではtrueにしても実投稿は構造的に拒否される。
ALLOW_LIVE_INSTAGRAM_PUBLISH=false

# Vercel Cron用の共有シークレット(/api/cron/analytics のBearer認証。未設定なら401)。実値をコミットしない。
CRON_SECRET=

# ---- V6 投稿後分析 ----

# Instagram Insightsの自動取得境界。既定disabled。V6では実装が無いためdry_run/liveでも
# Metaへ通信しない(手動入力が正)。permission確認・アプリレビュー完了後の将来機能。
INSTAGRAM_INSIGHTS_MODE=disabled
